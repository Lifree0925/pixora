NODE_ENV=development
APP_PORT=3000
APP_URL=http://127.0.0.1:3000
APP_BIND_HOST=127.0.0.1

STORAGE_DRIVER=supabase
DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/ai_image_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_image_studio

YIJIE_BASE_URL=https://yijieapi.com
YIJIE_API_KEY=
YIJIE_MODEL=gr-gpt-image-2
YIJIE_EDIT_VERIFIED=false
YIJIE_MULTI_IMAGE_EDIT_VERIFIED=false
YIJIE_GPT_IMAGE_2_5_EDIT_VERIFIED=false
YIJIE_GPT_IMAGE_2_5_MULTI_IMAGE_EDIT_VERIFIED=false
YIJIE_GEMINI_NANO_BANANA_2_1_EDIT_VERIFIED=false
YIJIE_GEMINI_NANO_BANANA_2_1_MULTI_IMAGE_EDIT_VERIFIED=false

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pixora-inputs
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600

S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ai-image-studio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=3600

MAX_UPLOAD_MB=20
MAX_TOTAL_UPLOAD_MB=80
MAX_REFERENCE_IMAGES=8
MAX_IMAGE_PIXELS=40000000
MAX_RESULT_MB=50
PROMPT_MAX_CHARS=8000

TASK_POLL_MAX_SECONDS=900
TASK_POLL_MIN_SECONDS=2
TASK_POLL_MAX_INTERVAL_SECONDS=30
TASK_LEASE_SECONDS=60
TASK_QUERY_TIMEOUT_SECONDS=30
WORKER_POLL_INTERVAL_MS=2000

OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_URL_DOCKER=

LOG_LEVEL=info
