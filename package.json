{
  "name": "pixora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && pnpm worker:build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node dist/worker/index.js",
    "worker:dev": "tsx watch worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "verify:yijie": "tsx scripts/verify-yijie.ts",
    "postinstall": "prisma generate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "storage:check": "tsx scripts/check-storage.ts",
    "e2e:mock": "tsx scripts/e2e-mock.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/worker/index.js --external:@prisma/client --external:sharp",
    "probe:prepare": "tsx scripts/prepare-probe-assets.ts prepare",
    "probe:cleanup": "tsx scripts/prepare-probe-assets.ts cleanup"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "file-type": "22.3.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
