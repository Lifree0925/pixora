{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["worker/**/*.ts", "src/lib/**/*.ts", "src/providers/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "**/*.test.ts"]
}
